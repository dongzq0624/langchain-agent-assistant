# =============================================
# AI 入职助手 — 部署环境变量配置
# =============================================
#
# 使用方法：
#   1. 复制本文件为 .env.production
#   2. 填入真实的 API Key 和配置
#   3. .env.production 不会提交到 Git
#
# ⚠️ 重要：API Key 属于敏感信息，切勿提交到代码仓库！
# =============================================

# ========== 服务配置 ==========
# 服务端口（默认 3000，无需修改）
PORT=3000

# ========== DeepSeek API 配置（默认使用） ==========
# DeepSeek API Key（从 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=sk-7b1b2d1fc68c4a9599d6aad7c8944329

# DeepSeek API 地址（通常无需修改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# DeepSeek 模型（deepseek-chat / deepseek-reasoner）
DEEPSEEK_MODEL=deepseek-chat

# 向量嵌入模型（用于语义检索，目前支持 OpenAI 的 embedding 模型）
DEEPSEEK_EMBEDDING_MODEL=text-embedding-ada-002

# ========== 其他 AI 提供商（可选） ==========
# 如果你想使用其他模型，可以在模型设置弹窗中配置

# OpenAI API Key（可选，用于向量检索）
# OPENAI_API_KEY=sk-your-openai-api-key-here

# ========== 日志与调试 ==========
# 日志级别：error | warn | info | debug（生产环境建议 info）
# LOG_LEVEL=info
