# =============================================
# 前端开发环境变量
# =============================================
#
# Vite 启动时会自动加载此文件（NODE_ENV=development）
# 开发环境通过 vite proxy 代理 /api 请求到后端
# 因此 VITE_API_BASE_URL 留空即可
#
# 更多配置请参考 .env.example
# =============================================

# API 地址（开发环境留空，走 vite proxy）
VITE_API_BASE_URL=
